`pragma protect end_protected
module embedded_sdram (
  clk_24m,
  pll_lock,
  l_hostif_sdrc_wr_n,
  l_hostif_sdrc_rd_n,
  l_hostif_sdrc_addr,
  l_hostif_sdrc_data,
  l_hostif_sdrc_data_len,
  O_sdram_ras_n_d,
  O_sdram_cke_d,
  O_sdram_wen_n_d,
  O_sdram_cas_n_d,
  n280_6,
  O_sdrc_rd_valid,
  l_sdram_init_done,
  O_sdrc_busy_n,
  O_sdram_ba_d,
  O_sdram_addr_d,
  O_sdram_dqm_d,
  O_sdrc_data,
  IO_sdram_dq
)
;
input clk_24m;
input pll_lock;
input l_hostif_sdrc_wr_n;
input l_hostif_sdrc_rd_n;
input [7:0] l_hostif_sdrc_addr;
input [31:0] l_hostif_sdrc_data;
input [4:3] l_hostif_sdrc_data_len;
output O_sdram_ras_n_d;
output O_sdram_cke_d;
output O_sdram_wen_n_d;
output O_sdram_cas_n_d;
