  initial begin : tc_smoke
    tb_addr                     = 16'h0000;
    tb_ctrl_rd_data             = 32'h0000_004D;
    tb_status_rd_data           = 32'h0000_05AD;
    tb_irq_enable_rd_data       = 32'h0000_0003;
    tb_irq_status_rd_data       = 32'h0000_0001;
    tb_model_ctrl_rd_data       = 32'h0000_0105;
    tb_model_status_rd_data     = 32'hA5A5_1201;
    tb_model_id_rd_data         = 32'h4F43_5231;
    tb_model_crc_rd_data        = 32'h1234_5678;
    tb_preproc_ctrl_rd_data     = 32'h0000_0011;
    tb_preproc_status_rd_data   = 32'h0000_0005;
    tb_bbox_x_rd_data           = 32'h001B_0004;
    tb_bbox_y_rd_data           = 32'h001F_0002;
    tb_nn_ctrl_rd_data          = 32'h0000_0003;
    tb_nn_status_rd_data        = 32'h0000_0011;
    tb_nn_model_select          = 1'b0;
    tb_nn_layer_count           = 8'd2;
    tb_dsp_config_rd_data       = 32'h0000_031C;
    tb_dsp_status_rd_data       = 32'h0000_0007;
    tb_dsp_cycles_total_rd_data = 32'h0000_0C80;
    tb_dsp_cycles_l0_rd_data    = 32'h0000_0C00;
    tb_dsp_cycles_l1_rd_data    = 32'h0000_0080;
    tb_dsp_cycles_l2_rd_data    = 32'h0000_0000;
    tb_result_class             = 6'd10;
    tb_result_char              = 8'h41;
    tb_result_score0_rd_data    = 32'h0001_2345;
    tb_result_score1_rd_data    = 32'h0001_0000;
    tb_result_conf_gap_rd_data  = 32'h0000_2345;
    tb_oled_ctrl_rd_data        = 32'h0000_0005;
    tb_oled_status_rd_data      = 32'h0000_0003;
    tb_oled_toggle_ms_rd_data   = 32'h0000_03E8;
    tb_version_rd_data          = 32'h0001_0000;
    tb_build_id_rd_data         = 32'h2026_0501;

    expect_word(16'h0000, 32'h0000_004D, "ctrl");
    expect_word(16'h0002, 32'h0000_004D, "ctrl byte alias");
    expect_word(16'h0004, 32'h0000_05AD, "status");
    expect_word(16'h0008, 32'h0000_0003, "irq enable");
    expect_word(16'h000C, 32'h0000_0001, "irq status");
    expect_word(16'h0010, 32'h0000_0105, "model ctrl");
    expect_word(16'h0014, 32'hA5A5_1201, "model status");
    expect_word(16'h0018, 32'h4F43_5231, "model id");
    expect_word(16'h001C, 32'h1234_5678, "model crc");
    expect_word(16'h0020, 32'h0000_0011, "preproc ctrl");
    expect_word(16'h0024, 32'h0000_0005, "preproc status");
    expect_word(16'h0028, 32'h001B_0004, "bbox x");
    expect_word(16'h002C, 32'h001F_0002, "bbox y");
    expect_word(16'h0030, 32'h0000_0003, "nn ctrl");
    expect_word(16'h0034, 32'h0000_0011, "nn status");
    expect_word(16'h0038, 32'h0000_0000, "nn model select");
    tb_nn_model_select = 1'b1;
    expect_word(16'h0038, 32'h0000_0001, "nn model select set");
    tb_nn_model_select = 1'b0;
    expect_word(16'h003C, 32'h0000_0002, "nn layer count");
    expect_word(16'h0040, 32'h0000_031C, "dsp config");
    expect_word(16'h0044, 32'h0000_0007, "dsp status");
    expect_word(16'h0048, 32'h0000_0C80, "dsp cycles total");
    expect_word(16'h004C, 32'h0000_0C00, "dsp cycles l0");
    expect_word(16'h0050, 32'h0000_0080, "dsp cycles l1");
    expect_word(16'h0054, 32'h0000_0000, "dsp cycles l2");
    expect_word(16'h0058, 32'h0000_0000, "reserved gap after l2");
    expect_word(16'h0060, 32'h0000_000A, "result class");
    expect_word(16'h0064, 32'h0000_0041, "result char");
    expect_word(16'h0068, 32'h0001_2345, "result score0");
    expect_word(16'h006C, 32'h0001_0000, "result score1");
    expect_word(16'h0070, 32'h0000_2345, "result confidence gap");
    expect_word(16'h0080, 32'h0000_0005, "oled ctrl");
    expect_word(16'h0084, 32'h0000_0003, "oled status");
    expect_word(16'h0088, 32'h0000_03E8, "oled toggle ms");
    expect_word(16'h008C, 32'h0000_0000, "oled reserved gap");
    expect_word(16'h00F0, 32'h0001_0000, "version");
    expect_word(16'h00F4, 32'h2026_0501, "build id");
    expect_word(16'h00F8, 32'h0000_0000, "trailing reserved");

    log_info("OCR REG MAP TB", "char_ocr_reg_map smoke test passed");
    $finish;
  end